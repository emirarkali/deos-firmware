/*
 * ==============================================================================
 * KARTA ÖZEL OVERLAY DOSYASI (boards/nucleo_h563zi.overlay)
 * ==============================================================================
 * Hedef Kart: NUCLEO-H563ZI (STM32H5)
 * Amacı: app.overlay dosyasında tanımlanan iskeletin (node ve alias'ların),
 * bu spesifik karta ait fiziksel pinlere ve donanımlara (UART, GPIO vb.) 
 * nasıl bağlanacağını (kablolanacağını) belirler.
 * ==============================================================================
 */

/ {
    aliases {
        lora-uart = &lpuart1;
        led2 = &red_led_1;
    };
};

/* CAN-FD Physical Pin Mapping */
&fdcan1 {
    pinctrl-0 = <&fdcan1_rx_pd0 &fdcan1_tx_pd1>;
    pinctrl-names = "default";
};

/* LoRa UART Physical Pin Mapping */
&lpuart1 {
    status = "okay";
    current-speed = <115200>;
    /* Note: H5 varsayılan olarak PB6(TX) ve PB7(RX) pinlerini kullanır */
};

/* LoRa AUX Physical Pin Mapping */
/ {
    lora_module {
        compatible = "gpio-keys";
        lora_aux: lora_aux {
            gpios = <&gpioe 14 GPIO_ACTIVE_HIGH>;
            label = "LoRa AUX Pin";
        };
    };
};
