/*
 * Zephyr Devicetree Overlay for DEOS Main STM32 Gateway
 * Board: NUCLEO-H7A3ZI-Q
 */

/ {
    chosen {
        zephyr,can-primary = &fdcan1;
    };
    
    aliases {
        lora-uart = &lpuart1;
    };
};

/* Enable Primary CAN (FDCAN1) and assign specific pins */
&fdcan1 {
    pinctrl-0 = <&fdcan1_rx_pd0 &fdcan1_tx_pd1>;
    pinctrl-names = "default";
    status = "okay";
    /* Note: bitrate config is read from app.overlay or handled here if different */
};

/* Disable usart1 to prevent any conflicts with LoRa pins (if necessary) */
&usart1 {
    status = "disabled";
};

/* lpuart1 is configured for PB6/PB7 (LoRa UART) - already defined in board dts but we reinforce it */
&lpuart1 {
    status = "okay";
    current-speed = <115200>;
};

&lora_aux {
    gpios = <&gpiod 5 GPIO_ACTIVE_HIGH>; /* Örnek olarak H7'de D5 pinine takıldığını varsayıyoruz */
};

